{
  "name": "@lostgradient/weft",
  "version": "0.30.0",
  "description": "A Bun-native durable execution engine with pluggable key-value storage.",
  "keywords": [
    "bun",
    "durable-execution",
    "workflow",
    "saga",
    "temporal",
    "storage",
    "key-value"
  ],
  "homepage": "https://github.com/stevekinney/weft#readme",
  "bugs": {
    "url": "https://github.com/stevekinney/weft/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevekinney/weft.git",
    "directory": "packages/weft"
  },
  "license": "MIT",
  "author": "Steve Kinney <hello@stevekinney.net>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js",
      "default": "./dist/worker/index.js"
    },
    "./worker/authoring": {
      "types": "./dist/worker/authoring.d.ts",
      "import": "./dist/worker/authoring.js",
      "default": "./dist/worker/authoring.js"
    },
    "./worker/generated-authoring": {
      "types": "./dist/worker/generated-authoring.d.ts",
      "import": "./dist/worker/generated-authoring.js",
      "default": "./dist/worker/generated-authoring.js"
    },
    "./a2a": {
      "types": "./dist/a2a/index.d.ts",
      "import": "./dist/a2a/index.js",
      "default": "./dist/a2a/index.js"
    },
    "./storage": {
      "types": "./dist/embedded/storage/src/index.d.ts",
      "import": "./dist/embedded/storage/src/index.js",
      "default": "./dist/embedded/storage/src/index.js"
    },
    "./storage/bun-sqlite": {
      "types": "./dist/embedded/storage-bun-sqlite/src/index.d.ts",
      "bun": "./dist/embedded/storage-bun-sqlite/src/index.js"
    },
    "./storage/indexeddb": {
      "types": "./dist/embedded/storage-indexeddb/src/index.d.ts",
      "import": "./dist/embedded/storage-indexeddb/src/index.js",
      "default": "./dist/embedded/storage-indexeddb/src/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "weft": "dist/cli-main.js",
    "weft-mcp": "dist/cli-mcp.js"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:binary": "bun run scripts/build-binary-main.ts",
    "clean": "rm -rf dist coverage tsconfig.tsbuildinfo",
    "dev": "bun --watch run src/index.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepack": "bun run build && bun run verify:exports && bun run verify:portability && bun run validate:package-consumers",
    "pr:title": "bun run scripts/pr-title.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "validate:package-consumers": "bun run scripts/validate-package-consumers.ts",
    "verify:exports": "bun run scripts/verify-tree-shaking.ts",
    "verify:portability": "bun run scripts/verify-portability.ts",
    "verify:release-version": "bun run scripts/verify-release-version.ts"
  },
  "dependencies": {
    "zod": "^4.6.6",
    "@lostgradient/environmentalist": "0.1.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@msgpack/msgpack": "^3.1.3",
    "@noble/hashes": "^2.4.0",
    "@valibot/to-json-schema": "^1.7.0",
    "smol-toml": "^1.9.0",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "svelte": "5.57.1",
    "zod": "^4.6.6",
    "typescript": "6.0.3",
    "happy-dom": "^21.0.4",
    "@testing-library/svelte": "^5.4.2",
    "@playwright/test": "^1.61.1",
    "@axe-core/playwright": "^4.10.0",
    "postcss-value-parser": "^4.2.0",
    "@lostgradient/environmentalist": "0.1.0",
    "@a2a-js/sdk": "1.3.0",
    "@electric-sql/pglite": "^0.5.1",
    "@libsql/client": "^0.17.2",
    "@modelcontextprotocol/client": "^2.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.11.0",
    "ajv": "^8",
    "better-sqlite3": "^12.8.0",
    "chalk": "^6.0.0",
    "change-case": "^5.4.4",
    "fake-indexeddb": "^6.2.5",
    "lmdb": "^3.5.2",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pg": "^8.11.0",
    "playwright": "^1.60.0",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sort-package-json": "^3.6.1",
    "standardwebhooks": "^1.1.1",
    "valibot": "^1.4.0"
  },
  "peerDependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@libsql/client": "^0.17.2",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "^1.0.0",
    "better-sqlite3": "^12.8.0",
    "lmdb": "^3.5.2",
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "@a2a-js/sdk": {
      "optional": false
    },
    "@libsql/client": {
      "optional": true
    },
    "@neondatabase/serverless": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "lmdb": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@valibot/to-json-schema": "^1.7.0"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}

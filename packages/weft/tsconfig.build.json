{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "incremental": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": false,
    "inlineSources": false
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "src/benchmarks/**",
    "src/cli/__fixtures__/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.test-d.ts",
    "**/*.test-support.ts",
    "**/*-fixture.ts",
    "**/__fixtures__/**",
    "**/__tests__/**"
  ]
}

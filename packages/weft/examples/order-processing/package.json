{
  "name": "weft-order-processing-example",
  "private": true,
  "type": "module",
  "scripts": {
    "client": "bun run src/client.ts",
    "lint": "oxlint --type-aware --tsconfig ./tsconfig.json src tests",
    "server": "bun run src/server.ts",
    "smoke:server": "bun test tests/smoke-server.test.ts",
    "test": "bun test",
    "tests": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "verify": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "@lostgradient/weft": "file:../.."
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "oxlint": "1.56.0",
    "typescript": "5.9.3"
  }
}
